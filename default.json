{
    "extends": [
        "config:best-practices",
        "github>hatena/renovate-config",
        "github>417-72KI/renovate-config:automerge",
        "github>417-72KI/renovate-config:schedule"
    ],
    "labels": ["dependencies"],
    "vulnerabilityAlerts": {
        "labels": ["security"]
    },
    "packageRules": [
        {
            "matchManagers": ["swift"],
            "extractVersion": "^v?(?<version>.*)",
            "pin": {
                "enabled": false
            },
            "pinDigest": {
                "enabled": false
            },
            "pinDigests": false
        }
    ]
}